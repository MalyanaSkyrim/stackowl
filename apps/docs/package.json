    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "typescript": "^5.9.3"
  }
