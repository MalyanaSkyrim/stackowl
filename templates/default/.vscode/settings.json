{
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.addMissingImports": "explicit",
    "files.symlinks.enabled": "always"
  },
  "editor.formatOnSave": true,
  "tailwindCSS.classFunctions": ["tva", "tv"],
  "tailwindCSS.experimental.configFile": "packages/ui/tailwind.config.ts",
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    ".*ClassName",
    ".*Style"
  ],
  "window.title": "${dirty}${activeEditorShort}${separator}starter-app${separator}${profileName}${separator}${appName}"
}
