  ],
  "files": [
    ".changeset/*.md",
    "**/*.md",
    "**/*.mdx",
    "**/*.json",
    "**/*.cjs",
    "**/*.mjs",
    "**/*.js",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx"
  ],
  "useGitignore": true,
  "overrides": [
    {
      // set caseSensitive to false. Some language dictionaries (like German, French, Spanish) turn on case sensitivity by default. Setting the global "caseSensitive": false is not sufficient
      "filename": "*",
      "languageSettings": [
        {
          "languageId": "*",
          "caseSensitive": false
        }
      ]
    },
    {
      "filename": "**/locales/fr/*.json",
      "language": "en,fr"
    },
    {
      "filename": "**/locales/fr.json",
      "language": "en,fr"
    },
    {
      "filename": "**/messages/fr.json",
      "language": "en,fr"
    },
    {
      "filename": "**/messages/ar.json",
      "language": "en,ar"
    },
    {
      "filename": "apps/mobile/src/lib/i18n/messages/fr.json",
      "language": "en,fr"
    },
    {
      "filename": "apps/mobile/src/lib/i18n/messages/ar.json",
      "language": "en,ar"
    },
    {
      // Stories show Arabic sample text with harakat, which no dictionary lists.
      "filename": "packages/ui/src/components/**/*.stories.tsx",
      "ignoreRegExpList": ["/[\\u0600-\\u06FF]+/g"]
    }
  ],
  "import": [
    "@cspell/dict-fr-fr/cspell-ext.json",
    "@cspell/dict-ar/cspell-ext.json"
  ],
  "ignorePaths": [
    "node_modules",
    "**/CHANGELOG.md",
    "**/lib/fonts"
  ]
}
