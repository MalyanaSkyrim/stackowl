# Copy this file to `.env` at the repo root and fill in the values (`setupwise create` does it
# for you, with generated local secrets). `.env` is gitignored. Never commit real secrets.
# `pnpm doctor` says which keys are still missing, and what each one unlocks.

# ----------------------------------------------------------------------------
# Mobile app (apps/mobile). Restart Metro after changing EXPO_PUBLIC_* values.
# ----------------------------------------------------------------------------
EXPO_PUBLIC_APP_NAME="Starter App"
# Base bundle identifier / Android package. Staging and production builds share it.
APP_BUNDLE_ID="com.example.starterapp"
# Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=""
APPLE_TEAM_ID=""
# The API the app calls. On a real iPhone, use the Mac's network address (http://192.168.x.x:4000).
EXPO_PUBLIC_API_URL="http://localhost:4000"
# The website the app opens for Privacy and Terms, no trailing slash. Leave empty for production.
EXPO_PUBLIC_WEB_URL="http://localhost:3003"
# Google sign-in: the iOS OAuth client id and its reversed form
# (com.googleusercontent.apps.<id>). Leave empty to hide the Google button.
# Add the same client id to GOOGLE_OAUTH_CLIENT_IDS below.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=""

# ----------------------------------------------------------------------------
# Web app (apps/web)
# ----------------------------------------------------------------------------
# Meta Pixel id. Leave empty to load no tracking script.
NEXT_PUBLIC_META_PIXEL_ID=""

# ----------------------------------------------------------------------------
# API (apps/api) and database (packages/database)
# ----------------------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
# Any long random string locally: `openssl rand -base64 32`.
API_KEY=""
# Signs the access tokens. Any long random string locally: `openssl rand -base64 32`.
AUTH_SECRET=""
# The local database and Redis from `pnpm db:start` (docker-compose.yml). `setupwise create`
# picks free ports when these are taken by another project.
DB_PORT=26261
DB_ADMIN_PORT=8086
REDIS_PORT=6383
# The local CockroachDB from `pnpm db:start`, on DB_PORT.
DATABASE_URL="postgresql://starter_app@localhost:26261/starter_app?sslmode=disable"
# Used by `pnpm --filter=@starter/api test`, after `pnpm db:push:test`.
TEST_DATABASE_URL="postgresql://starter_app@localhost:26261/starter_app_test?sslmode=disable"
# Email codes, sent through Resend. RESEND_FROM is the sender, on a domain verified in Resend
# (e.g. "Starter App <no-reply@example.com>"). Left empty in development, the codes are
# written to the API log instead.
RESEND_API_KEY=""
RESEND_FROM=""
# Comma-separated Google OAuth client ids accepted for Google sign-in.
GOOGLE_OAUTH_CLIENT_IDS=""
# Sign in with Apple: the app's bundle identifier.
APPLE_SIGN_IN_IOS_BUNDLE_ID=""

# ----------------------------------------------------------------------------
# Infrastructure (infra/, apps/docs/content/architecture/infrastructure.md)
# ----------------------------------------------------------------------------
# The Google Cloud project that holds staging and production. Used by `pnpm infra:init` and
# `pnpm infra:describe`. The values of the API's secrets go in `.env.staging` /
# `.env.production` (gitignored), for `pnpm secrets:set <env> --apply`.
GCP_PROJECT_ID=""

# ----------------------------------------------------------------------------
# Tooling (optional)
# ----------------------------------------------------------------------------
# Turborepo remote cache
TURBO_TOKEN=""
TURBO_TEAM=""
