{
  "name": "@starter/design-tokens",
  "version": "1.0.0",
  "description": "Design tokens shared by web and mobile: CSS variables, NativeWind theme and Tailwind preset",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
