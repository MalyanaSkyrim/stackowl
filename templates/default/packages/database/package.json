{
  "name": "@starter/database",
  "version": "1.0.0",
  "description": "Prisma schema and database client for the API",
  "license": "MIT",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:push:test": "node ../../tooling/scripts/with-test-db.mjs prisma db push",
    "db:seed": "tsx prisma/seeds/seed.ts",
    "dev": "prisma studio --browser none",
    "db:generate": "node ../../tooling/scripts/clean.mjs generated && prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@starter/config": "workspace:*",
    "@types/pg": "^8.11.10",
    "bcryptjs": "^3.0.2",
    "prisma-json-types-generator": "^3.6.2"
  },
  "dependencies": {
    "@starter/common": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "^16.4.7",
    "exponential-backoff": "^3.1.1",
    "pg": "^8.13.1",
    "prisma": "^7.0.0",
    "zod": "^4.4.3"
  }
}
