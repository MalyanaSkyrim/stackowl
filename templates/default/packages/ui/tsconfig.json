{
  "extends": "@starter/config/typescript/react-library.json",
  "compilerOptions": {
    //"outDir": "dist"
    "baseUrl": ".",
    "paths": {
      "@starter/ui": ["./src/index.ts"],
      "@starter/ui/*": ["./src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"], // Matches all files in `src` and its subdirectories
  "exclude": ["node_modules", "dist"] // Avoid excluding everything with "./*"
}
